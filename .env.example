NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<encoded-password>@YOUR-CLUSTER.mongodb.net/Students-Data

# Register this exact local callback in the GitHub OAuth App settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Use a long random value; never commit the real value from your local .env.
SESSION_SECRET=
