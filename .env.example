NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<encoded-password>@YOUR-CLUSTER.mongodb.net/Students-Data
BASE_URL=http://localhost:3000
# Classroom version. Set true and fill the Google/session settings to restore login.
AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
TRUST_PROXY_HOPS=0
