{
  "name": "class-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Classroom GraphQL CRUD API with Express, MongoDB and optional Google OIDC.",
  "engines": {
    "node": "24.x"
  },
  "license": "ISC",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "indexes": "node --env-file=.env --import=tsx scripts/create-indexes.ts",
    "indexes:production": "node dist/scripts/create-indexes.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/merge": "^9.2.8",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "iron-session": "^9.0.1",
    "mongoose": "^9.11.2",
    "openid-client": "^6.8.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
